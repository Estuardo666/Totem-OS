# Database
DATABASE_URL="file:./dev.db"

# Google APIs
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Auth
AUTH_SECRET=your_auth_secret_here
NEXTAUTH_SECRET=your_nextauth_secret_here
NEXTAUTH_URL=http://localhost:3000

# API v1 (hash HMAC de identificadores para rate limiting distribuido)
RATE_LIMIT_HASH_SECRET=your_rate_limit_hash_secret_here

# UploadThing
UPLOADTHING_SECRET=your_uploadthing_secret_here
UPLOADTHING_APP_ID=your_uploadthing_app_id_here
# OneSignal (Push Notifications)
# Backend
ONESIGNAL_APP_ID=your_onesignal_app_id
ONESIGNAL_REST_API_KEY=your_onesignal_rest_api_key

# Frontend
NEXT_PUBLIC_ONESIGNAL_APP_ID=your_onesignal_app_id
# REQUIRED for iOS/Safari push notifications
NEXT_PUBLIC_ONESIGNAL_SAFARI_WEB_ID=your_safari_web_id

# App nativa iOS / APNs
# El backend solo acepta registros cuyo bundle coincida exactamente.
APNS_BUNDLE_ID=com.totemmassmedia.totemos

# ============================================================================
# FACTURACIÓN ELECTRÓNICA ECUADOR (SRI)
# ============================================================================

# Ambiente SRI: 1=Pruebas, 2=Produccion
SRI_AMBIENTE=1

# Modo de firma: NUBE (worker Fly.io) o LOCAL (PC/servidor)
SRI_MODO=LOCAL

# Password del certificado .p12
SRI_P12_PASSWORD=your_p12_password_here

# Clave maestra para cifrar/descifrar .p12 almacenado en BD (solo modo LOCAL)
SRI_MASTER_KEY=your_32_char_master_key_here

# Worker ID (identificador único de la instancia del worker)
SRI_WORKER_ID=pc-local-01

# Secreto compartido para POST /api/facturacion/worker/latido.
# Generar al menos 32 caracteres aleatorios y configurar el mismo valor en el worker.
FACTURACION_WORKER_SECRET=replace_with_at_least_32_random_characters

# URL pública de Totem OS usada por el worker para enviar su latido.
TOTEM_API_URL=https://totem-os.vercel.app

# URLs del SRI (seleccionadas automáticamente por SRI_AMBIENTE)
# Pruebas: https://celcer.sri.gob.ec/comprobantes-electronicos-ws/
# Produccion: https://cel.sri.gob.ec/comprobantes-electronicos-ws/

# Email - Resend
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM="Facturacion <facturas@tudominio.com>"
EMAIL_REPLY_TO=patricia@tudominio.com

# Playwright E2E (usar valores exclusivos de pruebas; nunca credenciales personales)
E2E_TEST_EMAIL=e2e-user@example.com
E2E_TEST_PASSWORD=replace_with_a_unique_random_password

# Cifrado de tokens de acceso en reposo (AES-256-GCM).
# Genera con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# Meta / Facebook (developers.facebook.com)
META_APP_ID=
META_APP_SECRET=
# Configuracion de "Inicio de sesion con Facebook para empresas". Si esta
# presente, los permisos los define esa configuracion y Meta ignora el
# parametro `scope` de la URL de autorizacion.
META_CONFIG_ID=

# Usuario del sistema de Business Manager. Su sola presencia cambia el modo:
# la app deja de usar el token de OAuth guardado en la base y usa este, que no
# vence y pertenece al negocio en vez de a una persona. Se genera en
# Business Manager > Usuarios del sistema > Generar token, con vencimiento
# "Nunca". Quitar esta variable revierte al modo OAuth.
META_SYSTEM_USER_TOKEN=
# Opcionales y solo cosmeticos: lo que muestra la pagina de integraciones.
META_SYSTEM_USER_ID=
META_SYSTEM_USER_NAME=

# TikTok Login Kit + Display API (developers.tiktok.com)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
