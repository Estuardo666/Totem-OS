# Database
DATABASE_URL="file:./dev.db"

# Google APIs
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Auth
NEXTAUTH_SECRET=your_nextauth_secret_here
NEXTAUTH_URL=http://localhost:3000

# UploadThing
UPLOADTHING_SECRET=your_uploadthing_secret_here
UPLOADTHING_APP_ID=your_uploadthing_app_id_here
# OneSignal (Push Notifications)
# Backend
ONESIGNAL_APP_ID=your_onesignal_app_id
ONESIGNAL_REST_API_KEY=your_onesignal_rest_api_key

# Frontend
NEXT_PUBLIC_ONESIGNAL_APP_ID=your_onesignal_app_id
# REQUIRED for iOS/Safari push notifications
NEXT_PUBLIC_ONESIGNAL_SAFARI_WEB_ID=your_safari_web_id

# ============================================================================
# FACTURACIÓN ELECTRÓNICA ECUADOR (SRI)
# ============================================================================

# Ambiente SRI: 1=Pruebas, 2=Produccion
SRI_AMBIENTE=1

# Modo de firma: NUBE (worker Fly.io) o LOCAL (PC/servidor)
SRI_MODO=LOCAL

# Password del certificado .p12
SRI_P12_PASSWORD=your_p12_password_here

# Clave maestra para cifrar/descifrar .p12 almacenado en BD (solo modo LOCAL)
SRI_MASTER_KEY=your_32_char_master_key_here

# Worker ID (identificador único de la instancia del worker)
SRI_WORKER_ID=pc-local-01

# URLs del SRI (seleccionadas automáticamente por SRI_AMBIENTE)
# Pruebas: https://celcer.sri.gob.ec/comprobantes-electronicos-ws/
# Produccion: https://cel.sri.gob.ec/comprobantes-electronicos-ws/

# Email - Resend
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM="Facturacion <facturas@tudominio.com>"
EMAIL_REPLY_TO=patricia@tudominio.com