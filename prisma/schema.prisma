// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// ============================================================================
// 🔄 SWITCH ENTRE SQLITE (LOCAL) Y POSTGRESQL (NUBE)
// ============================================================================
// 
// ANTES DE HACER 'db push' A LA NUBE (Neon):
// 1. Cambiar 'provider' de "sqlite" a "postgresql"
// 2. Cambiar 'url' de 'env("DATABASE_URL")' a 'env("POSTGRES_PRISMA_URL")'
// 3. Añadir 'directUrl = env("POSTGRES_URL_NON_POOLING")'
// 4. Verificar que las variables de entorno en .env apunten a Neon
//
// PARA VOLVER A SQLITE (DESARROLLO LOCAL):
// 1. Cambiar 'provider' de "postgresql" a "sqlite"
// 2. Cambiar 'url' a 'env("DATABASE_URL")'
// 3. Remover 'directUrl'
// 4. Verificar que DATABASE_URL="file:./dev.db" en .env
//
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

// 🔧 PRODUCCIÓN/NUBE (PostgreSQL Neon) - ACTIVO
  datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // Connection Pooling
  directUrl = env("DATABASE_URL_UNPOOLED") // Direct connection
}

// 🔧 DESARROLLO LOCAL (SQLite) - COMENTADO
 //datasource db {
 //  provider = "sqlite"
 // url      = env("DATABASE_URL")
//}

// USUARIOS Y EQUIPO (compatible con Auth.js)
model User {
  id            String    @id @default(cuid())
  name          String
  firstName     String?
  lastName      String?
  email         String    @unique
  emailVerified DateTime?
  image         String? // URL de la foto de perfil
  password      String? // Opcional: solo para usuarios con credenciales (no Google)
  
  // Legacy: Campo string para compatibilidad
  roleLegacy    String   @default("EDITOR") @map("role") // "ADMIN", "EDITOR"
  
  // Campo de texto para especialidad (se llena desde la tabla Specialty)
  specialty     String? // Ej: "Community Manager", "Diseñador Gráfico"
  salaryType    String    @default("MONTHLY") // "HOURLY", "MONTHLY", "PROFIT_SHARE" (default MONTHLY, admins suelen usar PROFIT_SHARE)
  baseSalary    Float? // Sueldo mensual fijo (opcional)
  profitSharePercent Float? // Porcentaje de participación en ganancias (opcional, para socios, ej: 50.0)
  emergencyFundEligible Boolean @default(true) // Si participa en el reparto de utilidades y recibe aportes al fondo
  bankAccountInfo String? // Información de cuenta bancaria para transferencias
  hourlyRate    Float     @default(0.0) // Tarifa por hora en USD
  currency      String    @default("USD")
  
  // Configuración de usuario
  soundNotifications Boolean @default(true)
  primaryColor       String  @default("#27221F")
  darkMode           Boolean @default(false)

  // Relaciones de Auth.js
  accounts Account[]
  sessions Session[]

  // Relaciones de la aplicación
  tasksAsEditor       ContentTask[]     @relation("AssignedEditor")
  tasksAsCommunity    ContentTask[]     @relation("AssignedCommunity")
  expensesPaid     Expense[]          @relation("PaidByUser")
  transactions     Transaction[]      @relation("TransactionUser") // Gastos asignados para reembolso
  transactionsReceived Transaction[]  @relation("TransactionRecipient") // Honorarios/salarios recibidos
  payrolls          Payroll[]
  shoots           Shoot[]           @relation("ShootCrew")
  internalTransfers InternalTransfer[] @relation("InternalTransferUser")
  clientsAsEditor   Client[]          @relation("ClientEditor") // Clientes donde es editor responsable
  clientsAsCommunity Client[]         @relation("ClientCommunity") // Clientes donde es community manager
  notifications     Notification[]     // Notificaciones recibidas
  voiceNotes        VoiceNote[]        // Notas de voz personales
  timeEntries       TimeEntry[]        // Registros de tiempo trabajado
  googleCalendarToken GoogleCalendarToken? // Token de Google Calendar
  financeAlertsAssigned FinanceAlert[] @relation("FinanceAlertAssigned")
  approvedMonthlyClosures ClientMonthlyClosure[] @relation("MonthlyClosureApprovedBy")
  profitDistributions  ProfitDistributionItem[] @relation("ProfitDistributionItemUser")
  emergencyFundMovements EmergencyFundMovement[] @relation("EmergencyFundAuthorizedBy")
  electronicRetentions   ElectronicRetention[]   @relation("ElectronicRetentionUser")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([roleLegacy])
}

// ============================================================================
// MODELO DE ROLES - NUEVO SISTEMA DE PERMISOS
// ============================================================================

model Role {
  id          String   @id @default(cuid())
  name        String   @unique // Ej: "Admin", "Editor"
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ESPECIALIDADES (Catálogo dinámico para el campo specialty en User)
model Specialty {
  id    String @id @default(cuid())
  name  String @unique
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Modelos de Auth.js
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// CLIENTES (COMMAND CENTER)
model Client {
  id     String @id @default(cuid())
  name   String
  email  String?
  contactEmails String? // JSON array de correos adicionales (usados para Calendar)
  status String @default("ACTIVE") // ACTIVE, PAUSED, DEBT, INACTIVE
  color  String @default("#000000") // Color de marca del cliente

  // JSON Blobs para flexibilidad (almacenados como String en SQLite)
  brandKit   String? // { colors: [], fonts: [], driveLink: "" }
  vault      String? // { instagram: { user, pass }, ... } (encrypted)
  planConfig String? // { quota: { reels: 3, flyers: 1 } }
  brandDNA   String? // { businessDescription, toneOfVoice, audience, values }
  metricsConfig String? // { enabledMetrics: ["metaViews", "metaLikes", ...] }

  // Contrato mensual de entregables
  monthlyReels  Int   @default(0) // Cantidad de Reels contratados al mes
  monthlyFlyers Int   @default(0) // Cantidad de Flyers contratados al mes
  monthlyShoots Int   @default(0) // Cantidad de rodajes/sesiones contratadas al mes
  monthlyRate   Float @default(0) // Tarifa mensual del plan (para cobro automático)
  paymentDay    Int?  // Día del mes para cobro (1-31)
  billingStartDate DateTime? // Fecha desde la que inicia la facturación recurrente
  logo          String? // URL del logotipo del cliente

  // Asignación por Cliente
  editorId    String? // Editor responsable de la cuenta
  editor      User?   @relation("ClientEditor", fields: [editorId], references: [id], onDelete: SetNull)
  communityId String? // Community Manager responsable de la publicación
  community   User?   @relation("ClientCommunity", fields: [communityId], references: [id], onDelete: SetNull)

  lastPostDate     DateTime?
  shareToken       String? @unique // Token para enlaces compartidos de reportes
  reportLastViewed DateTime? // Última vez que el cliente vio el reporte compartido
  hasPendingFeedback Boolean @default(false) // Indica si el cliente tiene feedback pendiente de revisar
  
  // IA Performance Overview
  lastAiOverview     String? // Último análisis de performance generado por IA (almacenado como texto)
  lastAiOverviewDate DateTime? // Fecha de la última generación
  
  // Meta Graph API Integration
  facebookPageId      String? // ID de la Fanpage vinculada
  instagramBusinessId String? // ID de la cuenta de Instagram vinculada
  pageAccessToken     String? // Token específico de la página (necesario para leer insights sin que caduque la sesión del usuario)
  adAccountId         String? // ID de la cuenta publicitaria de Meta (para IA Ads Advisor y optimizaciones)

  // Facturación Electrónica - Datos fiscales
  tipoIdentificacion   String?  // RUC, CEDULA, PASAPORTE, CONSUMIDOR_FINAL
  numeroIdentificacion String?  // 13 dígitos RUC o 10 cédula
  razonSocial          String?  // Nombre legal/fiscal
  direccionFiscal      String?  // Dirección fiscal
  emailFacturacion     String?  // Email para enviar facturas electrónicas
  aplicaRetencion      Boolean  @default(false)
  porcentajeRetIva     Float?   @default(0)
  porcentajeRetRenta   Float?   @default(0)

  tasks        ContentTask[]
  expenses     Expense[]
  invoices     Invoice[]
  transactions Transaction[]
  credentials  Credential[]
  brandAssets  BrandAsset[]
  feedbacks    ClientFeedback[]
  shootings    Shoot[]
  metrics      ClientMetric[]
  monthlyClosures ClientMonthlyClosure[]
  monthlyStrategies ClientMonthlyStrategy[]
  billingExceptions ClientBillingException[]

  // Facturación Electrónica
  electronicInvoices ElectronicInvoice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([name])
  @@index([editorId])
  @@index([communityId])
}

// BÓVEDA DE CREDENCIALES
model Credential {
  id       String  @id @default(cuid())
  service  String // "Instagram", "Web", "Email", etc.
  username String
  password String
  url      String?

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([service])
}

// PRODUCCIÓN (CONTENT FACTORY)
model ContentTask {
  id          String    @id @default(cuid())
  title       String
  type        String // REEL, FLYER, STORY
  status      String // IDEA, RECORDED, EDITING, REVIEW_INTERNAL, REVIEW_CLIENT, CLIENT_APPROVED, APPROVED, PUBLISHED
  priority    String    @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  dueDate     DateTime?
  scheduledAt DateTime? // Fecha y hora programada para publicación
  publishedAt DateTime?

  // Link Mágico
  reviewToken    String? @unique
  clientFeedback String?

  // Recursos Creativos
  postCopy       String? // Texto del post/copy
  coverImageUrl  String? // URL de la imagen de portada subida
  audioBriefUrl  String? // URL de la nota de voz (Totem Voice)
  scriptUrl      String? // URL del archivo del guión (PDF/Word/TXT)

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  assignedEditorId String?
  assignedEditor   User?   @relation("AssignedEditor", fields: [assignedEditorId], references: [id], onDelete: SetNull)
  assignedCommunityId String?
  assignedCommunity   User?   @relation("AssignedCommunity", fields: [assignedCommunityId], references: [id], onDelete: SetNull)
  assignedAt   DateTime? // Fecha en que se asignó la tarea (para badge "Nuevo")

  shootId String?
  shoot   Shoot?  @relation(fields: [shootId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relación con métricas
  metrics TaskMetrics?

  @@index([clientId])
  @@index([assignedEditorId])
  @@index([assignedCommunityId])
  @@index([status])
  @@index([type])
  @@index([priority])
}

model Shoot {
  id            String        @id @default(cuid())
  title         String
  startTime     DateTime // Fecha y hora de inicio
  endTime       DateTime // Fecha y hora de finalización
  address       String? // Dirección escrita
  mapLink       String? // Link de Google Maps
  googleEventId   String? // ID del evento en Google Calendar
  googleEventLink String? // Link al evento en Google Calendar
  scriptUrl     String? // Archivo del guión (PDF/Word)
  audioBriefUrl String? // Nota de voz
  notes         String? // Notas adicionales del rodaje
  status        String        @default("SCHEDULED") // SCHEDULED, COMPLETED, CANCELED
  
  clientId      String
  client        Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  
  tasks         ContentTask[] // Relación One-to-Many (una tarea puede estar en un rodaje)
  crew          User[]        @relation("ShootCrew") // Relación Many-to-Many
  
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  
  @@index([clientId])
  @@index([startTime])
  @@index([endTime])
  @@index([status])
}

// FINANZAS (TOTEM POCKET)
model Expense {
  id          String   @id @default(cuid())
  description String
  amount      Float
  category    String // SOFTWARE, EQUIPMENT, OFFICE, PAYROLL
  date        DateTime @default(now())
  receiptUrl  String?

  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  // Control de Reembolsos
  paidByUserId String? // Si existe, es deuda de la empresa al usuario
  paidByUser   User?   @relation("PaidByUser", fields: [paidByUserId], references: [id], onDelete: SetNull)
  reimbursed   Boolean @default(false)

  payrollId String?
  payroll   Payroll? @relation(fields: [payrollId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([paidByUserId])
  @@index([payrollId])
  @@index([reimbursed])
  @@index([date])
}

model Payroll {
  id    String @id @default(cuid())
  month Int
  year  Int

  // Calculadora Salarial
  baseSalary     Float
  reimbursements Float // Suma de expenses
  advances       Float
  previousDebt   Float
  totalToPay     Float

  status     String // PENDING, PAID
  amountPaid Float  @default(0)

  userId   String
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expenses Expense[] // Gastos saldados en este rol

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, month, year])
  @@index([userId])
  @@index([status])
  @@index([year, month])
}

model Invoice {
  id          String    @id @default(cuid())
  amount      Float
  status      String // PENDING, SENT, PAID
  clientId    String
  client      Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  dueDate     DateTime?
  generatedAt DateTime  @default(now())

  // Facturación Electrónica
  electronicInvoice ElectronicInvoice?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([status])
  @@index([generatedAt])
}

// TRANSACCIONES (Sistema de cobro automático)
model Transaction {
  id          String  @id @default(cuid())
  amount      Float
  type        String // INCOME, EXPENSE, HONORARIOS
  status      String  @default("PENDING") // PENDING, PAID, CANCELLED
  description String?
  category    String? // Comida, Transporte, Invitaciones, Software, Otros

  // Relaciones
  relatedClientId String?
  relatedClient   Client? @relation(fields: [relatedClientId], references: [id], onDelete: SetNull)
  clientId        String? // Alias para relatedClientId (para compatibilidad)
  assignedToId    String? // Para vincular gastos a usuarios (reembolsos)
  assignedTo      User?   @relation("TransactionUser", fields: [assignedToId], references: [id], onDelete: SetNull)
  userId          String? // Para vincular honorarios/salarios a usuarios (quién recibió el pago)
  user            User?   @relation("TransactionRecipient", fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([relatedClientId])
  @@index([clientId])
  @@index([assignedToId])
  @@index([userId])
  @@index([status])
  @@index([type])
  @@index([category])
  @@index([createdAt])
}

// BRAND KIT ASSETS
model BrandAsset {
  id       String @id @default(cuid())
  name     String
  url      String
  fileKey  String @unique
  fileType String // "image", "pdf", "document"
  fileSize Int?   // Tamaño del archivo en bytes

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([fileType])
  @@index([fileSize])
}

// FEEDBACK DE CLIENTES
model ClientFeedback {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  
  month     Int      // Mes del reporte (1-12)
  year      Int      // Año del reporte
  
  approved  Boolean  @default(false) // Si el cliente aprobó el reporte
  approvedAt DateTime? // Fecha de aprobación
  
  comment   String?  // Comentario del cliente
  viewed    Boolean  @default(false) // Si el feedback ha sido visto por la agencia
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([month, year])
  @@unique([clientId, month, year]) // Un solo feedback por cliente/mes/año
}

// EXCEPCIONES DE FACTURACION MENSUAL POR CLIENTE
model ClientBillingException {
  id             String   @id @default(cuid())
  clientId       String
  client         Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  month          Int
  year           Int
  type           String
  overrideAmount Float?
  reason         String
  notes          String?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([clientId, year, month])
  @@index([clientId])
  @@index([year, month])
  @@index([type])
}

// TRACKING MENSUAL DE ESTRATEGIA POR CLIENTE
model ClientMonthlyStrategy {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  month     Int
  year      Int

  prepared  Boolean  @default(false)
  sentAt    DateTime?
  approved  Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([clientId, month, year])
  @@index([clientId])
  @@index([month, year])
}

// TRANSFERENCIAS INTERNAS (Liquidación de Honorarios y Salarios)
model InternalTransfer {
  id     String @id @default(cuid())
  userId String
  user   User   @relation("InternalTransferUser", fields: [userId], references: [id], onDelete: Cascade)
  
  amount Float
  month  Int
  year   Int
  type   String // "HONORARIOS", "SALARIO"
  status String @default("PENDING") // "PENDING", "PAID"
  
  description String? // Descripción opcional del pago
  paidAt      DateTime? // Fecha en que se registró el pago
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, month, year, type], name: "userId_month_year_type") // Un solo registro por usuario/mes/año/tipo
  @@index([userId])
  @@index([status])
  @@index([year, month])
  @@index([type])
}

// MÉTRICAS DE TAREAS (Meta - Instagram/Facebook y TikTok)
model TaskMetrics {
  id     String @id @default(cuid())
  taskId String @unique
  task   ContentTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  // Métricas Meta (Instagram/Facebook)
  metaViews    Int @default(0)
  metaLikes    Int @default(0)
  metaShares   Int @default(0)
  metaComments Int @default(0)
  metaSaves    Int @default(0)
  metaReach    Int @default(0) // Alcance (solo para Meta)

  // Métricas TikTok
  ttViews    Int @default(0)
  ttLikes    Int @default(0)
  ttShares   Int @default(0)
  ttComments Int @default(0)
  ttSaves    Int @default(0)

  // Métricas globales
  totalBudgetSpent Float? // Presupuesto gastado (opcional)
  notes            String? // Notas adicionales sobre las métricas

  // Métricas de conversión y ventas
  conversions      Int @default(0) // Leads, registros, clics en link de bio
  salesCount       Int @default(0) // Número de ventas cerradas
  revenue          Float @default(0.0) // Monto total en dinero generado por esta pieza
  conversionSource String? // Ej: "Link en Bio", "DM", "WhatsApp", "Web", "Local Físico"

  // Métricas calculadas
  erMeta    Float @default(0.0) // Engagement Rate Meta
  erTikTok  Float @default(0.0) // Engagement Rate TikTok
  totalBrandAwareness Float @default(0.0) // Reach Meta + Views TikTok
  globalSocialProof   Float @default(0.0) // Suma total de Likes y Comentarios
  viralityIndex      Float @default(0.0) // Relación Shares vs Views
  efficiencyScore    Float @default(0.0) // Promedio ponderado del ER global
  cpa                Float @default(0.0) // Costo por Adquisición (budget / salesCount)
  roas               Float @default(0.0) // Retorno a la Inversión Publicitaria (revenue / budget)
  conversionRate     Float @default(0.0) // Tasa de conversión (conversions / (metaReach + ttViews)) * 100

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([taskId])
}

// NOTAS DE VOZ PERSONALES (Totem Voice)
model VoiceNote {
  id        String   @id @default(cuid())
  userId    String
  audioUrl  String
  title     String?  @default("Nota de voz")
  createdAt DateTime @default(now())
  
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([createdAt])
}

// NOTIFICACIONES
model Notification {
  id         String   @id @default(cuid())
  userId     String   // El destinatario
  message    String
  type       String   // ej: "ASSIGNED", "STATUS_CHANGE", "INFO"
  read       Boolean  @default(false)
  createdBy  String?  // ID del usuario que creó la notificación (opcional, para mostrar foto de perfil)
  createdAt  DateTime @default(now())
  
  // Metadatos opcionales para enriquecer las notificaciones
  clientLogo String?  // URL del logo del cliente (para mostrar en notificaciones de tareas)
  clientName String?  // Nombre del cliente (para contexto adicional)
  
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([read])
  @@index([createdAt])
}

// ALERTAS FINANCIERAS
model FinanceAlert {
  id          String   @id @default(cuid())
  type        String   // CASH_FLOW, BUDGET, PROFITABILITY, CLIENT_RISK, ANOMALY, OPTIMIZATION
  severity    String   // LOW, MEDIUM, HIGH, CRITICAL
  status      String   @default("ACTIVE") // ACTIVE, ACKNOWLEDGED, RESOLVED
  title       String
  message     String
  fingerprint String   @unique // Evita duplicados por período/regla
  metadata    String?  // JSON string con datos de contexto

  assignedToId String? // Usuario responsable (opcional)
  assignedTo   User?    @relation("FinanceAlertAssigned", fields: [assignedToId], references: [id], onDelete: SetNull)
  resolvedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([severity])
  @@index([status])
  @@index([createdAt])
}

model FinanceAlertRule {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?
  enabled     Boolean  @default(true)
  severity    String   @default("MEDIUM")
  config      String   // JSON string con umbrales y parámetros

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([enabled])
}

// CONFIGURACIÓN GLOBAL DEL SISTEMA
model GlobalConfig {
  id    String   @id @default(cuid())
  key   String   @unique
  value String   // JSON string para valores complejos

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("global_config")
}

// INTEGRACIÓN META GRAPH API (Facebook & Instagram)
model AgencyMetaAccount {
  id             String   @id @default(cuid())
  facebookUserId String   // ID numérico del usuario de FB
  name           String   // Nombre del usuario, ej: "Stuart Admin"
  accessToken    String   // Token de usuario de larga duración (60 días)
  tokenExpiresAt DateTime // Fecha de expiración del token
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([facebookUserId])
}

// MÉTRICAS DE CLIENTES (Insights Engine)
model ClientMetric {
  id         String   @id @default(cuid())
  clientId   String
  client     Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  platform   String   // "FACEBOOK" | "INSTAGRAM"
  metricName String   // ej: "page_impressions", "page_engaged_users"
  value      Float
  date       DateTime // Fecha del dato
  fetchedAt  DateTime @default(now())

  @@unique([clientId, platform, metricName, date]) // Evita duplicados para el mismo día
  @@index([clientId, date]) // Optimiza la carga de gráficas
}

// CIERRE MENSUAL CONTABLE POR CLIENTE
model ClientMonthlyClosure {
  id            String   @id @default(cuid())
  clientId      String
  client        Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  year          Int
  month         Int
  accrualStatus String   // FULL, PARTIAL, NONE
  accruedAmount Float    @default(0)
  recommendation String? // FULL, PARTIAL, NONE, REVIEW
  recommendationReason String?
  evidenceSummary String? // JSON con métricas operativas del período
  notes         String?
  approvedById  String?
  approvedBy    User?    @relation("MonthlyClosureApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([clientId, year, month])
  @@index([year, month])
  @@index([clientId])
  @@index([accrualStatus])
  @@index([approvedById])
}

// DISTRIBUCIÓN DE UTILIDADES (Reparto formal de ganancias)
model ProfitDistribution {
  id             String    @id @default(cuid())
  year           Int
  month          Int
  status         String    @default("DRAFT") // DRAFT, APPROVED, PAID
  totalProfit    Float     // Utilidad neta del mes (collectedCash − gastos − honorarios)
  fundContribution Float    @default(0) // Monto apartado para el fondo de emergencia
  distributableAmount Float  @default(0) // totalProfit − fundContribution
  notes          String?
  approvedById   String?
  approvedAt     DateTime?
  paidAt         DateTime?
  items          ProfitDistributionItem[]

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([year, month])
  @@index([status])
}

model ProfitDistributionItem {
  id              String   @id @default(cuid())
  distributionId  String
  distribution    ProfitDistribution @relation(fields: [distributionId], references: [id], onDelete: Cascade)
  userId          String
  user            User     @relation("ProfitDistributionItemUser", fields: [userId], references: [id], onDelete: Cascade)
  percent         Float    // Porcentaje del usuario al momento de la distribución
  amount          Float    // Monto calculado: distributableAmount × percent / 100
  paidTransactionId String? // ID de la Transaction HONORARIOS creada al pagar

  createdAt       DateTime @default(now())

  @@index([distributionId])
  @@index([userId])
}

// FONDO DE EMERGENCIA (Movimientos de reserva)
model EmergencyFundMovement {
  id                     String   @id @default(cuid())
  type                   String   // CONTRIBUTION, WITHDRAWAL
  amount                 Float
  balanceAfter           Float    // Saldo acumulado después del movimiento
  year                   Int
  month                  Int
  reason                 String?
  authorizedByUserId     String?
  authorizedBy           User?    @relation("EmergencyFundAuthorizedBy", fields: [authorizedByUserId], references: [id], onDelete: SetNull)
  relatedTransactionId   String?  // Transaction EXPENSE creada al retirar

  createdAt              DateTime @default(now())

  @@index([type])
  @@index([year, month])
  @@index([authorizedByUserId])
}

// CONTROL DE TIEMPO - TOTEM CHRONOS
model TimeEntry {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskId        String?   // Opcional: vincular a una tarea específica
  clientId      String?   // Opcional: vincular a un cliente
  
  startTime     DateTime  @default(now())
  endTime       DateTime?
  duration      Int?      // En segundos (calculado al cerrar)
  hourlyRate    Float     // Tarifa horaria en ese momento ($)
  earnings      Float?    // Dinero ganado en esta sesión
  
  description   String?   // Descripción de lo trabajado
  aiSummary     String?   // Resumen generado por IA
  
  status        String    @default("RUNNING") // RUNNING, COMPLETED, MANUAL
  createdAt     DateTime  @default(now())

  @@index([userId, startTime])
  @@index([status])
  @@index([clientId])
  @@index([taskId])
}

// GOOGLE CALENDAR INTEGRATION
model GoogleCalendarToken {
  id           String   @id @default(cuid())
  userId       String   @unique
  accessToken  String
  refreshToken String
  expiresAt    DateTime
  scope        String   // Scopes autorizados
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
}

// ONESIGNAL PUSH NOTIFICATIONS
model OneSignalPlayer {
  id        String   @id @default(cuid())
  
  userId    String?  // Relación opcional con User (puede ser null si usuario no autenticado)
  playerId  String   @unique // ID del dispositivo en OneSignal
  device    String?  // Tipo de dispositivo: "ios", "android", "web"
  browser   String?  // Navegador si es web: "chrome", "safari", "firefox"
  
  // Metadata útil
  subscribed Boolean  @default(true) // Si el usuario tiene notificaciones activas
  lastSeen   DateTime? // Última actividad
  
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  
  @@index([userId])
  @@index([playerId])
}

// ============================================================================
// FACTURACIÓN ELECTRÓNICA ECUADOR (SRI)
// ============================================================================

// CONFIGURACIÓN DEL EMISOR (Singleton)
model CompanyConfig {
  id                String   @id @default(cuid())

  // Datos legales del emisor
  ruc               String   @unique
  razonSocial       String
  nombreComercial   String?
  direccionMatriz   String
  establecimiento   String   @default("001")
  puntoEmision      String   @default("001")

  // Configuración tributaria
  obligadoContabilidad Boolean @default(true)
  agenteRetencion     Boolean  @default(false)
  contribuyenteRimpe  Boolean  @default(false)

  // Ambiente SRI: 1=Pruebas, 2=Produccion
  sriAmbiente         String   @default("1")

  // Modo de firma: NUBE (worker Fly.io) o LOCAL (PC/servidor propio)
  modoFirma           String   @default("LOCAL")

  // .p12 local cifrado (AES-256-GCM) - se almacena en BD cuando modo=LOCAL
  p12LocalCifrado     Bytes?
  p12LocalIv          Bytes?
  p12LocalAuthTag     Bytes?
  p12LocalNombre      String?
  p12LocalSubidoAt    DateTime?

  // Huella del certificado (SHA-256 del cert, sin private key)
  p12Huella           String?
  p12Vence            DateTime?
  p12Titular          String?

  // Estado del worker
  workerModo          String?
  workerUltimoLatido  DateTime?
  workerVersion       String?
  workerHostname      String?

  // Configuración de email
  emailProveedor      String   @default("RESEND")
  emailFrom           String?
  emailReplyTo        String?
  emailBccAdmin       Boolean  @default(true)
  emailAsuntoTemplate String?  // plantilla con variables: {numero}, {cliente}
  emailCuerpoTemplate String?
  emailLogoUrl        String?

  // Secuenciales (próximo a usar)
  siguienteFactura      Int    @default(1)
  siguienteNotaCredito  Int    @default(1)
  siguienteRetencion    Int    @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// SECUENCIALES POR TIPO DE COMPROBANTE (atómico)
model SecuencialComprobante {
  id                String   @id @default(cuid())
  tipoComprobante   String   // "01"=Factura, "04"=NC, "07"=Retención
  establecimiento   String   // "001"
  puntoEmision      String   // "001"
  ultimoSecuencial  Int      @default(0)  // último autorizado por SRI
  siguiente         Int      @default(1)  // próximo a usar

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tipoComprobante, establecimiento, puntoEmision])
  @@index([tipoComprobante])
}

// CATÁLOGO DE PRODUCTOS/SERVICIOS PARA FACTURACIÓN
model ProductoFacturacion {
  id              String   @id @default(cuid())
  codigo          String   @unique  // "REEL-001", "SERV-DISENO"
  descripcion     String
  precioUnitario  Float
  tipoIva         String   @default("4")  // "0","2","4","6","7" (códigos SRI)
  unidad          String   @default("SERVICIO")  // SERVICIO, BIEN, HORA
  activo          Boolean  @default(true)

  aplicaIce       Boolean  @default(false)
  aplicaRetencion Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([activo])
  @@index([codigo])
}

// FACTURA ELECTRÓNICA
model ElectronicInvoice {
  id                String   @id @default(cuid())

  // Identificación SRI
  claveAcceso       String?  @unique  // 49 dígitos
  numeroAutorizacion String?          // Autorización del SRI
  secuencial        String            // "001-001-000000001"

  // Datos del cliente
  clientId          String
  client            Client   @relation(fields: [clientId], references: [id], onDelete: Restrict)
  tipoIdentificacion String
  numeroIdentificacion String
  razonSocial       String
  direccionCliente  String?
  emailCliente      String?

  // Montos
  subtotalSinImpuestos Float
  subtotal0         Float    @default(0)   // Base 0%
  subtotal2         Float    @default(0)   // Base 2% (régimen simplificado)
  subtotal4         Float    @default(0)   // Base 4% (régimen simplificado)
  subtotal12        Float    @default(0)   // Base IVA anterior
  subtotal15        Float    @default(0)   // Base 15% (IVA vigente desde abril 2025)
  valorIva          Float    @default(0)   // IVA calculado
  totalDescuento    Float    @default(0)
  propina           Float    @default(0)
  importeTotal      Float
  moneda            String   @default("DOLAR")

  // Forma de pago
  formaPagoCodigo   String   @default("20")  // "01","15","16","17","18","19","20","21"
  formaPagoPlazo    String?                   // "30"
  formaPagoUnidad   String?                   // "DIAS"
  pagos             String?   // JSON array para múltiples formas de pago

  // Estado del comprobante
  estado            String   @default("PENDIENTE_FIRMA")
  // PENDIENTE_FIRMA, FIRMADA, ENVIADA, AUTORIZADA, RECHAZADA, ANULADA, ERROR, CANCELADA_LOCAL

  // Archivos generados
  rideUrl           String?   // URL del PDF (RIDE) en UploadThing
  xmlUrl            String?   // URL del XML firmado
  xmlSriResponse    String?   // Respuesta XML del SRI (autorización)

  // Relación con Invoice existente (cuando se emite desde receivables)
  invoiceId         String?   @unique
  invoice           Invoice?  @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  // Relación con Notas de Crédito (cuando se anula)
  notasCredito      CreditNote[] @relation("FacturaOriginal")

  // Relación con Retenciones
  retenciones       ElectronicRetention[]

  // Fechas
  fechaEmision      DateTime  @default(now())
  fechaAutorizacion DateTime?
  fechaAnulacion    DateTime?

  // Auditoría
  intentosSri       Int       @default(0)
  ultimoErrorSri    String?
  codigoErrorSri    String?

  // Relaciones
  items             ElectronicInvoiceItem[]
  emailsEnviados    EmailEnviado[]
  jobs              SriJob[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([estado])
  @@index([fechaEmision])
  @@index([secuencial])
}

// LÍNEAS DE DETALLE DE FACTURA ELECTRÓNICA
model ElectronicInvoiceItem {
  id                  String   @id @default(cuid())
  facturaId           String
  factura             ElectronicInvoice @relation(fields: [facturaId], references: [id], onDelete: Cascade)

  codigoPrincipal     String   // código del producto/servicio
  descripcion         String
  cantidad            Float
  precioUnitario      Float
  descuento           Float    @default(0)
  precioTotalSinImpuesto Float

  // Impuesto por línea
  codigoImpuesto      String   // "2"=IVA
  codigoPorcentaje    String   // "0","2","4","6","7" (códigos SRI)
  tarifa              Float    // 0, 2, 4, 12, 15
  baseImponible       Float
  valorImpuesto       Float

  createdAt DateTime @default(now())

  @@index([facturaId])
}

// NOTA DE CRÉDITO ELECTRÓNICA
model CreditNote {
  id                String   @id @default(cuid())

  // Identificación SRI
  claveAcceso       String?  @unique
  numeroAutorizacion String?
  secuencial        String

  // Factura que modifica
  facturaOriginalId String
  facturaOriginal   ElectronicInvoice @relation("FacturaOriginal", fields: [facturaOriginalId], references: [id], onDelete: Restrict)

  // Datos del cliente
  clientId          String
  tipoIdentificacion String
  numeroIdentificacion String
  razonSocial       String

  // Montos
  subtotalSinImpuestos Float
  valorIva          Float
  importeTotal      Float
  moneda            String   @default("DOLAR")

  // Motivo
  motivo            String   // Descripción del ajuste
  tipoModificacion  String   // "DEVOLUCION", "DESCUENTO", "CORRECCION", "ANULACION"

  // Estado
  estado            String   @default("PENDIENTE_FIRMA")

  // Archivos
  rideUrl           String?
  xmlUrl            String?

  // Fechas
  fechaEmision      DateTime @default(now())
  fechaAutorizacion DateTime?

  // Auditoría
  intentosSri       Int       @default(0)
  ultimoErrorSri    String?

  // Relaciones
  items             CreditNoteItem[]
  jobs              SriJob[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([facturaOriginalId])
  @@index([clientId])
  @@index([estado])
}

// LÍNEAS DE DETALLE DE NOTA DE CRÉDITO
model CreditNoteItem {
  id                  String   @id @default(cuid())
  notaCreditoId       String
  notaCredito         CreditNote @relation(fields: [notaCreditoId], references: [id], onDelete: Cascade)

  codigoPrincipal     String
  descripcion         String
  cantidad            Float
  precioUnitario      Float
  descuento           Float    @default(0)
  precioTotalSinImpuesto Float

  codigoImpuesto      String
  codigoPorcentaje    String
  tarifa              Float
  baseImponible       Float
  valorImpuesto       Float

  createdAt DateTime @default(now())

  @@index([notaCreditoId])
}

// COMPROBANTE DE RETENCIÓN ELECTRÓNICA
model ElectronicRetention {
  id                String   @id @default(cuid())

  // Identificación SRI
  claveAcceso       String?  @unique
  numeroAutorizacion String?
  secuencial        String

  // Proveedor/Usuario (para honorarios)
  userId            String?
  user              User?    @relation("ElectronicRetentionUser", fields: [userId], references: [id], onDelete: SetNull)
  proveedorRuc      String?
  proveedorNombre   String?

  // Datos del sujeto retenido
  tipoSujeto        String   // "USUARIO" | "PROVEEDOR"
  tipoIdentificacion String
  numeroIdentificacion String
  razonSocial       String

  // Factura relacionada (opcional)
  facturaElectronicaId String?
  facturaElectronica   ElectronicInvoice? @relation(fields: [facturaElectronicaId], references: [id], onDelete: SetNull)

  // Periodo fiscal
  periodoFiscal     String   // "MM/YYYY"

  // Retenciones aplicadas (JSON array)
  retenciones       String   // [{tipoImpuesto,codigo,porcentaje,baseImponible,valorRetenido}]

  // Totales
  totalRetenido     Float

  // Estado
  estado            String   @default("PENDIENTE_FIRMA")

  // Archivos
  rideUrl           String?
  xmlUrl            String?

  // Relación con Transaction (pago de honorarios)
  transactionId     String?  @unique

  // Fechas
  fechaEmision      DateTime @default(now())
  fechaAutorizacion DateTime?

  // Auditoría
  intentosSri       Int       @default(0)
  ultimoErrorSri    String?

  // Relaciones
  jobs              SriJob[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([estado])
  @@index([fechaEmision])
  @@index([periodoFiscal])
}

// COLA DE TRABAJOS SRI (Worker polling)
model SriJob {
  id            String   @id @default(cuid())
  type          String   // "EMITIR_FACTURA", "NOTA_CREDITO", "RETENCION", "CONSULTAR_AUTORIZACION", "TEST"
  status        String   @default("PENDING") // PENDING, RUNNING, DONE, FAILED

  // Referencia polimórfica al comprobante
  facturaId     String?
  factura       ElectronicInvoice? @relation(fields: [facturaId], references: [id], onDelete: SetNull)
  notaCreditoId String?
  notaCredito   CreditNote? @relation(fields: [notaCreditoId], references: [id], onDelete: SetNull)
  retencionId   String?
  retencion     ElectronicRetention? @relation(fields: [retencionId], references: [id], onDelete: SetNull)

  // Payload y resultado
  payload       String?   // JSON con datos adicionales
  resultado     String?   // JSON con respuesta del SRI
  error         String?   // Mensaje de error si falló

  // Control de reintentos
  intentos      Int       @default(0)
  maxIntentos   Int       @default(3)
  procesadoAt   DateTime?
  disponibleAt  DateTime? // Para backoff exponencial

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([type])
  @@index([createdAt])
  @@index([disponibleAt])
}

// EMAILS ENVIADOS DE COMPROBANTES
model EmailEnviado {
  id            String   @id @default(cuid())
  facturaId     String?
  factura       ElectronicInvoice? @relation(fields: [facturaId], references: [id], onDelete: SetNull)
  notaCreditoId String?
  email         String
  status        String   @default("PENDIENTE") // PENDIENTE, ENVIADO, FALLIDO, REBOTADO
  providerId    String?  // ID del proveedor (Resend, etc.)
  intentos      Int      @default(0)
  error         String?
  enviadoAt     DateTime?

  createdAt DateTime @default(now())

  @@index([facturaId])
  @@index([status])
}

// LOG DE LATIDOS DEL WORKER
model WorkerLatido {
  id            String   @id @default(cuid())
  workerId      String
  modo          String   // "NUBE" | "LOCAL"
  hostname      String
  version       String?
  sriAmbiente   String   // "1" | "2"
  sriAlcanzable Boolean  @default(false)
  timestamp     DateTime @default(now())

  @@index([workerId])
  @@index([timestamp])
}
