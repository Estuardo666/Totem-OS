{
  "openapi": "3.1.0",
  "info": {
    "title": "Totem OS API",
    "version": "0.1.0",
    "description": "Versioned REST contract shared by the Next.js API, React and Swift clients."
  },
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "servers": [
    {
      "url": "/",
      "description": "Current Totem OS host"
    }
  ],
  "paths": {
    "/api/v1/_kernel/echo": {
      "get": {
        "operationId": "kernelEchoList",
        "summary": "List deterministic kernel items",
        "description": "Stateless contract endpoint used to verify pagination and client decoding.",
        "tags": [
          "Kernel"
        ],
        "security": [
          {
            "authjsSession": []
          }
        ],
        "parameters": [
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated kernel items.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/KernelEchoGetResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid pagination or cursor.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiProblem"
                }
              },
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiProblem"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required or session expired.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiProblem"
                }
              },
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiProblem"
                }
              }
            }
          },
          "403": {
            "description": "Capability is missing.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiProblem"
                }
              },
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiProblem"
                }
              }
            }
          },
          "405": {
            "description": "HTTP method is not allowed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiProblem"
                }
              },
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiProblem"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiProblem"
                }
              },
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiProblem"
                }
              }
            }
          },
          "503": {
            "description": "Rate-limit store unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiProblem"
                }
              },
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiProblem"
                }
              }
            }
          }
        },
        "x-required-capability": "kernel.echo.read"
      },
      "post": {
        "operationId": "kernelEcho",
        "summary": "Echo a validated message",
        "description": "Stateless contract endpoint used to verify JSON, validation and CSRF handling.",
        "tags": [
          "Kernel"
        ],
        "security": [
          {
            "authjsSession": [],
            "csrfToken": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/KernelEchoBody"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Validated echo response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/KernelEchoPostResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid JSON or body fields.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiProblem"
                }
              },
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiProblem"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required or session expired.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiProblem"
                }
              },
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiProblem"
                }
              }
            }
          },
          "403": {
            "description": "Capability or CSRF token is missing.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiProblem"
                }
              },
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiProblem"
                }
              }
            }
          },
          "405": {
            "description": "HTTP method is not allowed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiProblem"
                }
              },
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiProblem"
                }
              }
            }
          },
          "413": {
            "description": "Payload exceeds the endpoint limit.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiProblem"
                }
              },
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiProblem"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiProblem"
                }
              },
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiProblem"
                }
              }
            }
          },
          "503": {
            "description": "Rate-limit store unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiProblem"
                }
              },
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiProblem"
                }
              }
            }
          }
        },
        "x-required-capability": "kernel.echo.write"
      }
    }
  },
  "components": {
    "schemas": {
      "ApiProblem": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "format": "uri"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer",
            "minimum": 400,
            "maximum": 599
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string"
          },
          "code": {
            "type": "string",
            "enum": [
              "UNAUTHENTICATED",
              "SESSION_EXPIRED",
              "FORBIDDEN",
              "CSRF_FAILED",
              "RATE_LIMITED",
              "RATE_LIMIT_STORE_UNAVAILABLE",
              "INVALID_JSON",
              "INVALID_CONTENT_LENGTH",
              "VALIDATION_ERROR",
              "PAYLOAD_TOO_LARGE",
              "INVALID_CURSOR",
              "INVALID_PAGINATION",
              "METHOD_NOT_ALLOWED",
              "INTERNAL_ERROR"
            ]
          },
          "requestId": {
            "type": "string"
          },
          "retryAfter": {
            "type": "integer",
            "minimum": 0
          },
          "errors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/APIProblemIssue"
            }
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "instance",
          "code",
          "requestId"
        ],
        "additionalProperties": false
      },
      "APIProblemIssue": {
        "type": "object",
        "properties": {
          "path": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            }
          },
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "path",
          "code",
          "message"
        ],
        "additionalProperties": false
      },
      "KernelItem": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "label"
        ],
        "additionalProperties": false
      },
      "KernelEchoQuery": {
        "type": "object",
        "properties": {
          "cursor": {
            "type": "string",
            "minLength": 1
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          }
        },
        "additionalProperties": false
      },
      "KernelEchoBody": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 280
          }
        },
        "required": [
          "message"
        ],
        "additionalProperties": false
      },
      "KernelEchoCursor": {
        "type": "object",
        "properties": {
          "version": {
            "type": "number",
            "const": 1
          },
          "offset": {
            "type": "integer",
            "minimum": 0,
            "maximum": 60
          }
        },
        "required": [
          "version",
          "offset"
        ],
        "additionalProperties": false
      },
      "KernelEchoPagination": {
        "type": "object",
        "properties": {
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "hasMore": {
            "type": "boolean"
          },
          "nextCursor": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "limit",
          "hasMore",
          "nextCursor"
        ],
        "additionalProperties": false
      },
      "KernelEchoMeta": {
        "type": "object",
        "properties": {
          "requestId": {
            "type": "string"
          },
          "pagination": {
            "$ref": "#/components/schemas/KernelEchoPagination"
          }
        },
        "required": [
          "requestId",
          "pagination"
        ],
        "additionalProperties": false
      },
      "KernelEchoPostData": {
        "type": "object",
        "properties": {
          "echo": {
            "type": "string"
          }
        },
        "required": [
          "echo"
        ],
        "additionalProperties": false
      },
      "KernelEchoPostMeta": {
        "type": "object",
        "properties": {
          "requestId": {
            "type": "string"
          }
        },
        "required": [
          "requestId"
        ],
        "additionalProperties": false
      },
      "KernelEchoGetResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/KernelItem"
            }
          },
          "meta": {
            "$ref": "#/components/schemas/KernelEchoMeta"
          }
        },
        "required": [
          "data",
          "meta"
        ],
        "additionalProperties": false
      },
      "KernelEchoPostResponse": {
        "type": "object",
        "properties": {
          "data": {
            "$ref": "#/components/schemas/KernelEchoPostData"
          },
          "meta": {
            "$ref": "#/components/schemas/KernelEchoPostMeta"
          }
        },
        "required": [
          "data",
          "meta"
        ],
        "additionalProperties": false
      }
    },
    "securitySchemes": {
      "authjsSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "authjs.session-token",
        "description": "Auth.js session cookie. The secure production cookie uses the __Secure- prefix."
      },
      "csrfToken": {
        "type": "apiKey",
        "in": "header",
        "name": "x-csrf-token",
        "description": "Required for mutating requests together with the CSRF cookie."
      }
    }
  }
}
