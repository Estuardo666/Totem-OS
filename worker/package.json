{
  "name": "sri-worker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc",
    "build:wa": "node build-wa.mjs",
    "build:wa:hostinger": "npm install --include=dev --no-audit --no-fund && npm run build:wa && npm prune --omit=dev --no-audit --no-fund",
    "typecheck:wa": "tsc --project tsconfig.wa.json --pretty false",
    "start": "node --env-file=../.env --env-file=.env dist/worker/index.js",
    "start:wa": "node dist/whatsapp/index.js",
    "dev": "tsx --env-file=../.env --env-file=.env index.ts",
    "dev:wa": "node --env-file-if-exists=../.env --env-file-if-exists=.env --import tsx whatsapp/index.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.81",
    "@ai-sdk/google": "^4.0.98",
    "@ai-sdk/groq": "^4.0.62",
    "@ai-sdk/openai": "^4.0.95",
    "@prisma/client": "^5.19.0",
    "@whiskeysockets/baileys": "^6.7.24",
    "ai": "^7.0.142",
    "node-forge": "^1.3.1",
    "pdfkit": "^0.13.0",
    "pino": "^10.4.0",
    "qrcode": "^1.5.3",
    "resend": "^4.0.0",
    "soap": "^1.1.2",
    "xmlbuilder2": "^4.0.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "@types/node-forge": "^1.3.11",
    "@types/pdfkit": "^0.13.9",
    "@types/qrcode": "^1.5.5",
    "esbuild": "^0.28.2",
    "prisma": "^5.19.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.2"
  },
  "overrides": {
    "libsignal": "git+https://github.com/whiskeysockets/libsignal-node.git#bcea72df9ec34d9d9140ab30619cf479c7c144c7"
  }
}
